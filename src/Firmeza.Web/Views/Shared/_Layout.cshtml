<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Firmeza</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">F</span><span>FIRMEZA<small>GESTIÓN COMERCIAL</small></span></a>
            <div class="nav-caption">ADMINISTRACIÓN</div>
            <nav class="side-nav">
                <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"><span>⌂</span><span class="nav-text">Inicio</span></a>
                <a asp-controller="Products" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"><span>▦</span><span class="nav-text">Productos</span></a>
                <a asp-controller="Customers" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")"><span>♙</span><span class="nav-text">Clientes</span></a>
                <a asp-controller="Sales" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")"><span>↗</span><span class="nav-text">Ventas</span></a>
                <a asp-controller="Reports" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"><span>⇅</span><span class="nav-text">Importar / exportar</span></a>
            </nav>
            <div class="sidebar-bottom"><div class="sidebar-help"><span>✦</span><strong>Construimos contigo.</strong><small>Gestión clara para crecer con firmeza.</small></div></div>
        </aside>
        <main class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" type="button" aria-label="Guardar/alternar panel" aria-pressed="false">⟨</button>
                    <span class="topbar-label">FIRMEZA <span>/</span> @ViewData["Title"]</span>
                </div>
                <div class="user-menu">
                    <button class="theme-toggle" type="button" aria-label="Alternar modo oscuro" title="Alternar modo oscuro" aria-pressed="false"><span class="theme-toggle-icon">☾</span></button>
                    <div class="avatar">@(User.Identity.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "A")</div>
                    <div class="user-details"><strong>@(User.Identity?.Name ?? "Administrador")</strong><small>Administrador</small></div>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn-logout" type="submit" title="Cerrar sesión">↗</button></form>
                </div>
            </header>
            <div class="page-content">
                @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @RenderBody()
            </div>
            <footer class="footer">© @DateTime.UtcNow.Year Firmeza · Panel administrativo</footer>
        </main>
    </div>
}
else
{
    <main class="auth-page">
        <div class="auth-glow auth-glow-one"></div>
        <div class="auth-glow auth-glow-two"></div>
        <div class="auth-shell">
            @RenderBody()
        </div>
    </main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(() => {
    const shell = document.querySelector('.app-shell');
    const sidebarToggle = document.querySelector('.sidebar-toggle');
    const themeToggle = document.querySelector('.theme-toggle');
    const sidebarKey = 'firmeza-sidebar-collapsed';
    const themeKey = 'firmeza-theme-dark';

    if (shell && sidebarToggle) {
        const applySidebarState = (collapsed) => {
            shell.classList.toggle('sidebar-collapsed', collapsed);
            sidebarToggle.setAttribute('aria-pressed', String(collapsed));
            sidebarToggle.textContent = collapsed ? '⟩' : '⟨';
        };

        const savedSidebarState = localStorage.getItem(sidebarKey) === '1';
        applySidebarState(savedSidebarState);

        sidebarToggle.addEventListener('click', () => {
            const collapsed = !shell.classList.contains('sidebar-collapsed');
            applySidebarState(collapsed);
            localStorage.setItem(sidebarKey, collapsed ? '1' : '0');
        });
    }

    if (themeToggle) {
        const applyTheme = (darkMode) => {
            document.body.classList.toggle('theme-dark', darkMode);
            themeToggle.setAttribute('aria-pressed', String(darkMode));
            themeToggle.querySelector('.theme-toggle-icon').textContent = darkMode ? '☀' : '☾';
            themeToggle.title = darkMode ? 'Activar modo claro' : 'Activar modo oscuro';
        };

        const savedTheme = localStorage.getItem(themeKey) === '1';
        applyTheme(savedTheme);

        themeToggle.addEventListener('click', () => {
            const darkMode = !document.body.classList.contains('theme-dark');
            applyTheme(darkMode);
            localStorage.setItem(themeKey, darkMode ? '1' : '0');
        });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
