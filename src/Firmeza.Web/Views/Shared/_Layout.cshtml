<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Firmeza</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">F</span><span>FIRMEZA<small>GESTIÓN COMERCIAL</small></span></a>
            <div class="nav-caption">ADMINISTRACIÓN</div>
            <nav class="side-nav">
                <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"><span>⌂</span>Inicio</a>
                <a asp-controller="Products" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"><span>▦</span>Productos</a>
                <a asp-controller="Customers" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")"><span>♙</span>Clientes</a>
                <a asp-controller="Sales" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")"><span>↗</span>Ventas</a>
                <a asp-controller="Reports" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"><span>⇅</span>Importar / exportar</a>
            </nav>
            <div class="sidebar-bottom"><div class="sidebar-help"><span>✦</span><strong>Construimos contigo.</strong><small>Gestión clara para crecer con firmeza.</small></div></div>
        </aside>
        <main class="main-area">
            <header class="topbar"><div><span class="topbar-label">FIRMEZA <span>/</span> @ViewData["Title"]</span></div><div class="user-menu"><div class="avatar">@(User.Identity.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "A")</div><div class="user-details"><strong>@(User.Identity?.Name ?? "Administrador")</strong><small>Administrador</small></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn-logout" type="submit" title="Cerrar sesión">↗</button></form></div></header>
            <div class="page-content">
                @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @RenderBody()
            </div>
            <footer class="footer">© @DateTime.UtcNow.Year Firmeza · Panel administrativo</footer>
        </main>
    </div>
}
else
{
    <main class="auth-page">@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
