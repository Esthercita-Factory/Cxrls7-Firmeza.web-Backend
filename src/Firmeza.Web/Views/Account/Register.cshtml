@model RegisterViewModel
@{ ViewData["Title"] = "Crear cuenta de cliente"; Layout = "_Layout"; }
<section class="auth-card"><div class="auth-brand"><span class="brand-mark">F</span><div><strong>FIRMEZA</strong><small>CUENTA DE CLIENTE</small></div></div><div class="eyebrow">Comienza aquí</div><h1>Crear una cuenta.</h1><p>Regístrate para nuestros canales digitales de cliente.</p><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<form asp-action="Register" method="post"><div class="row g-3"><div class="col-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control"/><span asp-validation-for="FirstName" class="text-danger"></span></div><div class="col-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control"/><span asp-validation-for="LastName" class="text-danger"></span></div><div class="col-5"><label asp-for="DocumentType" class="form-label"></label><select asp-for="DocumentType" class="form-select"><option>Cédula</option><option>RUC</option><option>Pasaporte</option><option>Otro</option></select></div><div class="col-7"><label asp-for="DocumentNumber" class="form-label"></label><input asp-for="DocumentNumber" class="form-control"/><span asp-validation-for="DocumentNumber" class="text-danger"></span></div><div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-12"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger"></span></div><div class="col-12"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span><div class="form-text">Mínimo 10 caracteres, mayúscula, minúscula, número y símbolo.</div></div><div class="col-12"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div></div><button class="btn btn-primary" type="submit">Crear cuenta</button></form><div class="auth-links">¿Ya tienes cuenta? <a asp-action="Login">Iniciar sesión</a></div><div class="auth-note">El registro crea una cuenta con rol Cliente. Este rol no tiene acceso al panel administrativo Razor.</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
