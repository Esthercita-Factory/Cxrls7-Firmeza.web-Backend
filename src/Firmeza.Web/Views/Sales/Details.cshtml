@model Sale
@{ ViewData["Title"] = $"Venta #{Model.Id:D5}"; }
<div class="page-heading"><div><div class="eyebrow">Ventas / Detalle</div><h1>Orden #@Model.Id.ToString("D5")</h1><p>Registrada el @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, HH:mm").</p></div><div class="d-flex gap-2"><a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-primary">↓ Descargar recibo PDF</a><a asp-action="Index" class="btn btn-outline-secondary">← Volver</a></div></div>
<div class="row g-3 mb-3"><div class="col-md-6"><section class="panel-card h-100"><div class="panel-header"><h2>Cliente</h2></div><div class="p-3"><strong>@Model.Customer.FullName</strong><span class="table-sub">@Model.Customer.DocumentType · @Model.Customer.DocumentNumber</span><span class="table-sub">@(Model.Customer.Email ?? "Sin correo") · @(Model.Customer.Phone ?? "Sin teléfono")</span></div></section></div><div class="col-md-6"><section class="panel-card h-100"><div class="panel-header"><h2>Resumen</h2></div><div class="p-3"><span class="badge-soft">@Model.Status</span><div class="d-flex justify-content-between mt-3"><span>Subtotal</span><span>$@Model.Subtotal.ToString("N2")</span></div><div class="d-flex justify-content-between mt-1"><span>IVA (@Model.TaxRate.ToString("P0"))</span><span>$@Model.TaxAmount.ToString("N2")</span></div><div class="sale-total mt-2">Total: $@Model.Total.ToString("N2")</div></div></section></div></div>
<section class="panel-card"><div class="panel-header"><h2>Productos de la orden</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Producto</th><th>SKU</th><th>Cantidad</th><th>Precio unitario</th><th class="text-end">Subtotal</th></tr></thead><tbody>@foreach (var line in Model.Details) { <tr><td class="table-name">@line.Product.Name</td><td>@line.Product.Sku</td><td>@line.Quantity</td><td>$@line.UnitPrice.ToString("N2")</td><td class="text-end sale-total">$@line.LineTotal.ToString("N2")</td></tr> }</tbody><tfoot><tr><td colspan="4" class="text-end table-name">Total</td><td class="text-end sale-total">$@Model.Total.ToString("N2")</td></tr></tfoot></table></div></section>
