@model ProductFormViewModel
@{ ViewData["Title"] = "Nuevo producto"; }
<div class="page-heading"><div><div class="eyebrow">Catálogo / Nuevo</div><h1>Agregar producto</h1><p>Completa los datos del material que deseas registrar.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Volver</a></div>
