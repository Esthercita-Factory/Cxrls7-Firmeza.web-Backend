@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Productos";
}
<div class="page-heading"><div><div class="eyebrow">Catálogo</div><h1>Productos</h1><p>Administra materiales, precios e inventario.</p></div><a class="btn btn-primary" asp-action="Create">＋ &nbsp; Agregar producto</a></div>
<form class="toolbar" method="get"><div class="search-form"><input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Buscar por nombre o SKU…"/><select class="form-select" name="category" style="max-width:190px"><option value="">Todas las categorías</option>@foreach (string category in ViewBag.Categories) { <option value="@category" selected="@(category == (string?)ViewBag.Category)">@category</option> }</select><button class="btn btn-outline-secondary" type="submit">Filtrar</button></div><span class="ms-auto text-secondary small">@Model.Count producto(s)</span></form>
<section class="panel-card">
@if (Model.Count == 0) { <div class="empty-state"><span class="metric-icon mx-auto">▦</span><strong>No hay productos para mostrar</strong><span>Prueba otra búsqueda o agrega el primer producto.</span></div> }
else { <div class="table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Existencias</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var product in Model) { <tr><td><span class="table-name">@product.Name</span><span class="table-sub">@product.Sku · / @product.UnitOfMeasure</span></td><td>@product.Category</td><td class="table-name">$@product.UnitPrice.ToString("N2")</td><td><span class="@(product.Stock <= product.MinimumStock ? "badge-soft badge-warn" : "")">@product.Stock</span></td><td><span class="badge-soft">Activo</span></td><td><div class="actions"><a class="action-link" asp-action="Edit" asp-route-id="@product.Id">Editar</a><a class="action-link danger" asp-action="Delete" asp-route-id="@product.Id">Eliminar</a></div></td></tr> }
</tbody></table></div> }
</section>
